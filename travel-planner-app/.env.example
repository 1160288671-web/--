# 复制本文件为 .env 并填入配置。支持任意 OpenAI 兼容的 API。
# .env 已在 .gitignore 中，不会被提交。

# API Key（必填）
LLM_API_KEY=sk-在这里填入你的key

# API 地址（必填，不带 /chat/completions 后缀）
# DeepSeek: https://api.deepseek.com/v1
# Moonshot(Kimi): https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
# DeepSeek: deepseek-chat / deepseek-reasoner
# Moonshot: kimi-k2-0905-preview
LLM_MODEL=deepseek-chat

# 高德开放平台「Web服务」Key（可选；用于方案地图，未配置时地图自动隐藏）
# 申请地址：https://console.amap.com/  → 创建「Web服务」类型 Key
AMAP_KEY=

# 高德数字签名「私钥/安全密钥」（可选；若在控制台为该 Key 开启了「数字签名」则必填）
# 控制台 → 应用管理 → 我的应用 → 对应 Key 的「设置」里查看
AMAP_SECRET=
